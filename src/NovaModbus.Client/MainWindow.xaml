<Window x:Class="NovaModbus.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NovaModbus.Client"
        mc:Ignorable="d"
        Title="NovaModbus Client" Height="600" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Serial Port"
                  DataContext="{Binding SerialSettings}">
            <StackPanel Margin="8">
                <Label Content="COM Port"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding AvailablePorts}"
                              SelectedItem="{Binding SelectedPort}"/>
                    <Button Grid.Column="1" Content="Refresh" Margin="4,0,0,0" Padding="8,0"
                            Command="{Binding RefreshPortsCommand}"/>
                </Grid>

                <Label Content="Baud Rate" Margin="0,8,0,0"/>
                <ComboBox IsEditable="True"
                          ItemsSource="{Binding AvailableBaudRates}"
                          Text="{Binding BaudRateText, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Data Bits" Margin="0,8,0,0"/>
                <ComboBox ItemsSource="{Binding AvailableDataBits}"
                          SelectedItem="{Binding DataBits}"/>

                <Label Content="Parity" Margin="0,8,0,0"/>
                <ComboBox ItemsSource="{Binding AvailableParity}"
                          SelectedItem="{Binding Parity}"/>

                <Label Content="Stop Bits" Margin="0,8,0,0"/>
                <ComboBox ItemsSource="{Binding AvailableStopBits}"
                          SelectedItem="{Binding StopBits}"/>

                <TextBlock Margin="0,12,0,0" Foreground="Gray" TextWrapping="Wrap"
                           Text="{Binding StatusMessage}"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <CheckBox Content="Built-in test slave" Margin="0,0,0,4"
                      IsChecked="{Binding TestSlaveEnabled}"/>
            <Button Content="Connect" Margin="0,0,0,4" Padding="0,4"
                    Command="{Binding ConnectCommand}"/>
            <Button Content="Disconnect" Padding="0,4"
                    Command="{Binding DisconnectCommand}"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="{Binding StatusText}"/>
        </StackPanel>
        </Grid>

        <TabControl Grid.Column="1" Margin="0,8,8,8">
            <TabItem Header="Read / Write" DataContext="{Binding ReadWrite}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <StackPanel Margin="0,0,8,0">
                            <Label Content="Function"/>
                            <ComboBox Width="180" ItemsSource="{Binding AvailableFunctions}"
                                      SelectedItem="{Binding SelectedFunction}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <Label Content="Slave ID"/>
                            <TextBox Width="70" Text="{Binding SlaveIdText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <Label Content="Start"/>
                            <TextBox Width="80" Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0" IsEnabled="{Binding NeedsCount}">
                            <Label Content="Count"/>
                            <TextBox Width="80" Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom">
                            <Button Content="Execute" Padding="16,2" Margin="0,0,0,1"
                                    Command="{Binding ExecuteCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0" IsEnabled="{Binding NeedsValues}">
                        <Label Content="{Binding HintText}"/>
                        <TextBox Text="{Binding ValuesText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <TextBox Grid.Row="2" Margin="0,8,0,0" IsReadOnly="True"
                             FontFamily="Consolas" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding ResultText, Mode=OneWay}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Polling" DataContext="{Binding Polling}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <StackPanel Margin="0,0,8,0">
                            <Label Content="Interval (ms)"/>
                            <TextBox Width="100" Text="{Binding IntervalMsText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Start" Padding="16,2" Margin="0,0,4,1"
                                    Command="{Binding StartCommand}"/>
                            <Button Content="Stop" Padding="16,2" Margin="0,0,0,1"
                                    Command="{Binding StopCommand}"/>
                        </StackPanel>
                    </StackPanel>
                    <ListBox Grid.Row="1" Margin="0,8,0,0" FontFamily="Consolas"
                             ItemsSource="{Binding History}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Log" DataContext="{Binding CommLog}">
                <ListBox Margin="8" FontFamily="Consolas"
                         ItemsSource="{Binding Lines}"/>
            </TabItem>
            <TabItem Header="Watch" DataContext="{Binding Watch}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <StackPanel Margin="0,0,8,0">
                            <Label Content="Slave ID"/>
                            <TextBox Width="70" Text="{Binding SlaveIdText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <Label Content="Area"/>
                            <ComboBox Width="140" ItemsSource="{Binding Areas}"
                                      SelectedItem="{Binding Area}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <Label Content="Address (dec/0x)"/>
                            <TextBox Width="80" Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <Label Content="End (range)"/>
                            <TextBox Width="80" Text="{Binding AddressEndText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <Label Content="Count / Record"/>
                            <TextBox Width="80" Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <Label Content="Extra (diag data / file len)"/>
                            <TextBox Width="140" Text="{Binding ExtraText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Add" Padding="16,2" Margin="0,0,4,1"
                                    Command="{Binding AddCommand}"/>
                            <Button Content="Add Range" Padding="16,2" Margin="0,0,4,1"
                                    Command="{Binding AddRangeCommand}"/>
                            <Button Content="Del" Padding="16,2" Margin="0,0,4,1"
                                    Click="OnWatchDelete"/>
                            <Button Content="Save" Padding="16,2" Margin="0,0,4,1"
                                    Command="{Binding SaveWatchCommand}"/>
                            <Button Content="Load" Padding="16,2" Margin="0,0,0,1"
                                    Command="{Binding LoadWatchCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0" Orientation="Horizontal">
                        <Button Content="Read All" Padding="16,2" Margin="0,0,8,0"
                                Command="{Binding ReadAllCommand}"/>
                        <CheckBox Content="Auto-refresh" VerticalAlignment="Center" Margin="0,0,8,0"
                                  IsChecked="{Binding AutoRefresh}"/>
                        <TextBox Width="80" VerticalAlignment="Center"
                                 Text="{Binding AutoIntervalMsText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Content="ms"/>
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                                   Text="{Binding StatusText}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" Margin="0,8,0,0" Name="WatchGrid"
                              AutoGenerateColumns="False" CanUserDeleteRows="False"
                              IsReadOnly="True" ItemsSource="{Binding Entries}"
                              SelectionMode="Extended"
                              KeyDown="OnWatchDeleteKey">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Slave" Binding="{Binding SlaveId}"/>
                            <DataGridTextColumn Header="Area" Binding="{Binding Area}"/>
                            <DataGridTextColumn Header="Address" Binding="{Binding Start}"/>
                            <DataGridTextColumn Header="AddressHex" Binding="{Binding AddressHex}"/>
                            <DataGridTextColumn Header="Count" Binding="{Binding Count}"/>
                            <DataGridTextColumn Header="Extra" Binding="{Binding Extra}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid Grid.Row="3" Margin="0,8,0,0" AutoGenerateColumns="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True" ItemsSource="{Binding Results}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Slave" Binding="{Binding Entry.SlaveId}"/>
                            <DataGridTextColumn Header="Area" Binding="{Binding Entry.Area}"/>
                            <DataGridTextColumn Header="Address" Binding="{Binding Entry.Start}"/>
                            <DataGridTextColumn Header="Dec" Binding="{Binding ValueDecText}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Hex" Binding="{Binding ValueHexText}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

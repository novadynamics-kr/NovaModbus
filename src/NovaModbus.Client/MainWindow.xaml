<Window
    x:Class="NovaModbus.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NovaModbus Client">
    <Grid x:Name="Root" ColumnSpacing="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="8" Spacing="8">
            <StackPanel DataContext="{Binding SerialSettings}" Spacing="4">
                <TextBlock Text="Serial Port" FontWeight="SemiBold"/>
                <TextBlock Text="COM Port"/>
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding AvailablePorts}"
                              SelectedItem="{Binding SelectedPort, Mode=TwoWay}"/>
                    <Button Grid.Column="1" Content="Refresh"
                            Command="{Binding RefreshPortsCommand}"/>
                </Grid>

                <TextBlock Text="Baud Rate"/>
                <ComboBox IsEditable="True" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding AvailableBaudRates}"
                          SelectedItem="{Binding BaudRatePreset, Mode=TwoWay}"
                          Text="{Binding BaudRateText, Mode=TwoWay}"/>

                <TextBlock Text="Data Bits"/>
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding AvailableDataBits}"
                          SelectedItem="{Binding DataBits, Mode=TwoWay}"/>

                <TextBlock Text="Parity"/>
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding AvailableParity}"
                          SelectedItem="{Binding Parity, Mode=TwoWay}"/>

                <TextBlock Text="Stop Bits"/>
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding AvailableStopBits}"
                          SelectedItem="{Binding StopBits, Mode=TwoWay}"/>

                <TextBlock Foreground="Gray" TextWrapping="Wrap"
                           Text="{Binding StatusMessage}"/>
            </StackPanel>

            <CheckBox Content="Built-in test slave"
                      IsChecked="{Binding TestSlaveEnabled, Mode=TwoWay}"/>
            <Button Content="Connect" HorizontalAlignment="Stretch"
                    Command="{Binding ConnectCommand}"/>
            <Button Content="Disconnect" HorizontalAlignment="Stretch"
                    Command="{Binding DisconnectCommand}"/>
            <TextBlock TextWrapping="Wrap" Text="{Binding StatusText}"/>
        </StackPanel>

        <TabView Grid.Column="1" Margin="0,8,8,8" IsAddTabButtonVisible="False">
            <TabViewItem IsClosable="False" Header="Read / Write" DataContext="{Binding ReadWrite}">
                <Grid Margin="8" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <StackPanel>
                            <TextBlock Text="Function"/>
                            <ComboBox Width="180"
                                      ItemsSource="{Binding AvailableFunctions}"
                                      SelectedItem="{Binding SelectedFunction, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Slave ID"/>
                            <TextBox Width="70" Text="{Binding SlaveIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Start"/>
                            <TextBox Width="80" Text="{Binding StartText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Count"/>
                            <TextBox Width="80" IsEnabled="{Binding NeedsCount}" Text="{Binding CountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom">
                            <Button Content="Execute" Padding="16,2"
                                    Command="{Binding ExecuteCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{Binding HintText}"/>
                        <TextBox IsEnabled="{Binding NeedsValues}" Text="{Binding ValuesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <TextBox Grid.Row="2" IsReadOnly="True" FontFamily="Consolas"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Text="{Binding ResultText, Mode=OneWay}"/>
                </Grid>
            </TabViewItem>
            <TabViewItem IsClosable="False" Header="Polling" DataContext="{Binding Polling}">
                <Grid Margin="8" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <StackPanel>
                            <TextBlock Text="Interval (ms)"/>
                            <TextBox Width="100" Text="{Binding IntervalMsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="4">
                            <Button Content="Start" Padding="16,2" Command="{Binding StartCommand}"/>
                            <Button Content="Stop" Padding="16,2" Command="{Binding StopCommand}"/>
                        </StackPanel>
                    </StackPanel>
                    <ListView Grid.Row="1" FontFamily="Consolas" ItemsSource="{Binding History}"/>
                </Grid>
            </TabViewItem>
            <TabViewItem IsClosable="False" Header="Log" DataContext="{Binding CommLog}">
                <ListView Margin="8" FontFamily="Consolas" ItemsSource="{Binding Lines}"/>
            </TabViewItem>
            <TabViewItem IsClosable="False" Header="Watch" DataContext="{Binding Watch}">
                <Grid Margin="8" RowSpacing="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>

                    <Grid.KeyboardAccelerators>
                        <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="OnWatchSelectAll"/>
                        <KeyboardAccelerator Key="Delete" Invoked="OnWatchDeleteKey"/>
                        <KeyboardAccelerator Key="Escape" Invoked="OnWatchDeselectAll"/>
                    </Grid.KeyboardAccelerators>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <StackPanel>
                            <TextBlock Text="Slave ID"/>
                            <TextBox Width="70" Text="{Binding SlaveIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Area"/>
                            <ComboBox Width="140" ItemsSource="{Binding Areas}"
                                      SelectedItem="{Binding Area, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Address (dec/0x)"/>
                            <TextBox Width="80" Text="{Binding StartText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="End (dec/0x)"/>
                            <TextBox Width="80" Text="{Binding AddressEndText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Count / Record"/>
                            <TextBox Width="80" Text="{Binding CountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Extra (diag data / file len)"/>
                            <TextBox Width="140" Text="{Binding ExtraText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="4">
                            <Button Content="Add" Padding="16,2" Command="{Binding AddCommand}"/>
                            <Button Content="Add Range" Padding="16,2" Command="{Binding AddRangeCommand}"/>
                            <Button Content="Del" Padding="16,2" Click="OnWatchDelete"/>
                            <Button Content="Clear All" Padding="16,2"
                                    Command="{Binding ClearAllCommand}"
                                    ToolTipService.ToolTip="Remove all entries and results (single operation)"/>
                            <Button Content="Select All" Padding="16,2"
                                    Command="{Binding SelectAllCommand}"
                                    ToolTipService.ToolTip="Select all entries (Ctrl+A)"/>
                            <Button Content="Deselect All" Padding="16,2"
                                    Command="{Binding DeselectAllCommand}"
                                    ToolTipService.ToolTip="Clear selection"/>
                            <Button Content="Save" Padding="16,2" Click="OnWatchSave"/>
                            <Button Content="Load" Padding="16,2" Click="OnWatchLoad"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Read All" Padding="16,2" Command="{Binding ReadAllCommand}"/>
                        <CheckBox Content="Auto-refresh" VerticalAlignment="Center"
                                  IsChecked="{Binding AutoRefresh, Mode=TwoWay}"/>
                        <TextBox Width="80" VerticalAlignment="Center"
                                 Text="{Binding AutoIntervalMsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="ms" VerticalAlignment="Center"/>
                        <ProgressBar Width="120" VerticalAlignment="Center"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding BulkProgress, Mode=OneWay}"/>
                        <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}"/>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8">
                        <Grid RowSpacing="4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Entries (" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Entries.Count}" FontWeight="SemiBold"/>
                                <TextBlock Text=")" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="40,0,0,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Slave" Foreground="Gray"/>
                                <TextBlock Grid.Column="1" Text="Area" Foreground="Gray"/>
                                <TextBlock Grid.Column="2" Text="Addr" Foreground="Gray"/>
                                <TextBlock Grid.Column="3" Text="Hex" Foreground="Gray"/>
                                <TextBlock Grid.Column="4" Text="Count" Foreground="Gray"/>
                                <TextBlock Grid.Column="5" Text="Extra" Foreground="Gray"/>
                            </Grid>
                            <ListView x:Name="EntriesList" Grid.Row="2" SelectionMode="Multiple" Background="{ThemeResource LayerFillColorDefaultBrush}" ItemsSource="{Binding Entries}"
                                      HorizontalContentAlignment="Stretch"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding SlaveId}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Area}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Start}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding AddressHex}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Count}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Extra}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8">
                        <Grid RowSpacing="4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Results (" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Results.Count}" FontWeight="SemiBold"/>
                                <TextBlock Text=")" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="40,0,0,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Slave" Foreground="Gray"/>
                                <TextBlock Grid.Column="1" Text="Area" Foreground="Gray"/>
                                <TextBlock Grid.Column="2" Text="Addr" Foreground="Gray"/>
                                <TextBlock Grid.Column="3" Text="Dec" Foreground="Gray"/>
                                <TextBlock Grid.Column="4" Text="Hex" Foreground="Gray"/>
                                <TextBlock Grid.Column="5" Text="Time" Foreground="Gray"/>
                                <TextBlock Grid.Column="6" Text="Status" Foreground="Gray"/>
                            </Grid>
                            <ListView x:Name="ResultsList" Grid.Row="2" SelectionMode="Multiple" Background="{ThemeResource LayerFillColorDefaultBrush}" ItemsSource="{Binding Results}"
                                      HorizontalContentAlignment="Stretch"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Entry.SlaveId}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Entry.Area}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Entry.Start}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding ValueDecText}" FontFamily="Consolas" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding ValueHexText}" FontFamily="Consolas" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Timestamp}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="{Binding Status}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage collectors: measure product assemblies only (tests excluded). -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage" uri="datacollector://Microsoft/CodeCoverage/2.0" assemblyQualifiedName="Microsoft.VisualStudio.Coverage.DynamicCoverageDataCollector, Microsoft.VisualStudio.TraceDataCollector, Version=15.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a">
        <Configuration>
          <CodeCoverage>
            <ModulePaths>
              <Exclude>
                <ModulePath>.*Tests\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Measure product assemblies only; test assemblies stay excluded. -->
          <Include>[NovaModbus.Rtu]*,[NovaModbus.Client]*,[NovaModbus.ClientWPF]*,[NovaModbus.Slave]*,[NovaModbus.SlaveWPF]*</Include>
          <Exclude>[NovaModbus.Rtu.Tests]*,[NovaModbus.Client.Tests]*,[NovaModbus.ClientWPF.Tests]*,[NovaModbus.Client.WinForms.Tests]*,[NovaModbus.Slave.Tests]*,[NovaModbus.SlaveWPF.Tests]*,[NovaModbus.Slave.WinForms.Tests]*</Exclude>
          <ExcludeByFile>**/tests/**</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
